# =============================================================================
# Investbras Intelligence - variaveis de ambiente
# Copie para .env no desenvolvimento e replique no painel do Netlify.
# Nenhuma chave privada pode aparecer em arquivo do frontend.
# =============================================================================

# --- Obrigatorio para liberar a area da mesa (/admin) ------------------------
# String longa e aleatoria. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Operador unico. Serve enquanto o Supabase Auth nao tem usuarios cadastrados.
# A senha precisa de 10 caracteres ou mais.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Mesa Investbras"

# --- Supabase ----------------------------------------------------------------
# Sem estas variaveis o painel funciona, mas publica so no navegador local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Necessario apenas para login por Supabase Auth em vez de ADMIN_EMAIL.
SUPABASE_ANON_KEY=

# --- Disparo de e-mail (Resend) ----------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Investbras Intelligence <mercado@investbras.com.br>"

# Usado nos links do e-mail e no descadastro. Sem barra no final.
SITE_URL=https://investbras.achillesmedia.com.br

# --- Geracao assistida por IA ------------------------------------------------
# Opcional. Sem chave, o rascunho sai apenas em modo tecnico.
# AI_PROVIDER aceita "openai" ou "gemini". Vazio usa a primeira chave presente.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Fontes de conteudo ------------------------------------------------------
# Feeds RSS separados por virgula. Vazio usa os padroes, que ja incluem uma
# busca dedicada a cafe, Agencia Brasil, Canal Rural, Money Times e InfoMoney.
NEWS_RSS_FEEDS=

# Defina como false para nao buscar og:image nas materias sem imagem no feed.
NEWS_FETCH_IMAGES=true

# Calendarios .ics adicionais, separados por virgula. A agenda do IBGE ja vem
# ligada por padrao e nao depende desta variavel.
AGENDA_ICS_URLS=

# --- Cafe robusta ------------------------------------------------------------
# O Yahoo nao expoe robusta em simbolo publico estavel. Ao contratar uma fonte,
# informe o ticker aqui e o contrato volta a aparecer na grade e na conversao.
ROBUSTA_SYMBOL=
ROBUSTA_CONTRACT="RC (ICE Londres)"
ROBUSTA_UNIT="USD/t"
